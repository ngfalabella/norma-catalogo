{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/catalogo/?$",
			"dest": "_render"
		},
		{
			"src": "^/producto/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	],
	"images": {
		"sizes": [
			160,
			320,
			480,
			640,
			828,
			1080,
			1600
		],
		"formats": [
			"image/avif",
			"image/webp"
		],
		"domains": [],
		"remotePatterns": []
	}
}