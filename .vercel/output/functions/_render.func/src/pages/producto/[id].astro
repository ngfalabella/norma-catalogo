---
import Layout from '../../layouts/Layout.astro';
import FotoProducto from '../../components/FotoProducto.astro';
import Icono from '../../components/Icono.astro';
import { Image } from 'astro:assets';
import { agruparPorCategoria, aItemCliente, getProductos, whatsappLink } from '../../lib/catalogo';

export const prerender = false;

const idPedido = (Astro.params.id ?? '').trim().toLowerCase();
const productos = await getProductos();
const producto = productos.find((p) => p.id.toLowerCase() === idPedido);

if (!producto) {
  return Astro.redirect('/catalogo');
}

const items = await Promise.all(productos.map(aItemCliente));
const item = items.find((i) => i.id === producto.id)!;
const categorias = agruparPorCategoria(productos).map(({ nombre, id }) => ({ nombre, id }));

// "También te puede gustar": misma categoría primero, con foto
const relacionados = [
  ...productos.filter((p) => p !== producto && p.categoriaId === producto.categoriaId && p.foto),
  ...productos.filter((p) => p !== producto && p.categoriaId !== producto.categoriaId && p.foto),
].slice(0, 3);

const consulta = whatsappLink(`Hola Mica! Te quería consultar por: ${producto.nombre} que vi en el catálogo`);
---

<Layout
  title={`${producto.nombre} | Moka`}
  description={producto.descripcion || undefined}
  items={items}
  categorias={categorias}
  detalle
>
  <div class="md:mx-auto md:max-w-6xl md:px-6 md:pt-8" data-detalle data-producto={producto.id}>
    <a href="/catalogo" class="mb-5 hidden items-center gap-2 text-sm text-ink-soft no-underline hover:text-ink md:inline-flex">
      <Icono nombre="volver" size={16} /> Volver al catálogo
    </a>

    <div class="md:grid md:grid-cols-2 md:items-start md:gap-10">
      <!-- Foto a sangre en mobile, tarjeta en tablet/desktop -->
      <div class="relative h-[460px] overflow-hidden bg-tint md:sticky md:top-28 md:h-auto md:aspect-[4/5] md:rounded-[var(--radius-feature)] md:shadow-feature">
        <FotoProducto
          producto={producto}
          eager
          widths={[640, 828, 1080, 1600]}
          sizes="(min-width: 1024px) 560px, (min-width: 768px) 50vw, 100vw"
          class="absolute inset-0"
          monograma="grande"
          fija
        />
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_18%,rgb(255_255_255/.35),transparent_50%)] mix-blend-soft-light"></div>

        <!-- Controles sobre la foto (mobile) -->
        <div class="absolute inset-x-3.5 top-[max(14px,env(safe-area-inset-top))] flex justify-between md:hidden">
          <a href="/catalogo" aria-label="Volver al catálogo" class="liquid grid size-11 place-items-center rounded-full text-ink">
            <Icono nombre="volver" />
          </a>
          <div class="flex gap-2">
            <button type="button" data-favorito={JSON.stringify(item)} aria-pressed="false" aria-label={`Guardar ${producto.nombre} en favoritos`} class="favorito liquid grid size-11 place-items-center rounded-full text-accent">
              <Icono nombre="corazon" />
            </button>
            <button type="button" data-abrir="pedido" data-destino-pedido aria-label="Ver mi pedido" class="liquid-bordo relative grid size-11 place-items-center rounded-full">
              <Icono nombre="bolsa" size={19} />
              <span data-contador-pedido hidden class="absolute right-1 top-1 grid h-4 min-w-4 place-items-center rounded-full bg-gold-400 px-1 text-[11px] font-semibold tabular-nums text-cocoa-950"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Hoja de información: se superpone a la foto en mobile -->
      <div class="relative -mt-10 rounded-t-[var(--radius-sheet)] bg-paper px-5 pb-36 pt-3 shadow-[0_-12px_30px_-16px_rgb(42_9_16/.35)] md:mt-0 md:rounded-none md:bg-transparent md:px-0 md:pb-0 md:pt-6 md:shadow-none">
        <div aria-hidden="true" class="mx-auto mb-[18px] h-1 w-10 rounded-full bg-ink/15 md:hidden"></div>

        <p class="mb-1.5 text-xs font-medium uppercase tracking-[.14em] text-ink-soft">
          <a href={`/catalogo#${producto.categoriaId}`} class="text-ink-soft no-underline hover:text-accent">{producto.categoria}</a>
        </p>
        <div class="flex items-baseline justify-between gap-3 md:block">
          <h1 class="font-serif text-[32px] font-normal leading-[1.05] tracking-[-.02em] md:text-5xl" style="view-transition-name: vt-titulo">
            {producto.nombre}
          </h1>
          <p
            class:list={['whitespace-nowrap text-xl font-semibold tabular-nums md:mt-4 md:text-2xl', producto.precio === null ? 'text-ink-soft font-medium text-base md:text-xl' : 'text-accent']}
            style="view-transition-name: vt-precio"
          >
            {producto.precioTexto}
          </p>
        </div>

        {producto.descripcion && (
          <p class="mt-3 max-w-prose text-[15px] leading-relaxed text-ink-soft md:mt-5 md:text-[17px]">{producto.descripcion}</p>
        )}

        <!-- Acciones (tablet/desktop) -->
        <div class="mt-8 hidden items-center gap-3 md:flex">
          <div class="flex items-center rounded-full border border-line bg-field">
            <button type="button" data-paso="-1" data-objetivo="cantidad-desk" aria-label="Quitar uno" class="grid size-12 place-items-center"><Icono nombre="menos" size={18} /></button>
            <span id="cantidad-desk" data-valor="1" aria-live="polite" class="min-w-6 text-center text-base font-semibold tabular-nums">1</span>
            <button type="button" data-paso="1" data-objetivo="cantidad-desk" aria-label="Agregar uno" class="grid size-12 place-items-center"><Icono nombre="mas" size={18} /></button>
          </div>
          <button type="button" data-agregar={JSON.stringify(item)} data-cantidad-ref="cantidad-desk" class="liquid-bordo h-12 flex-1 rounded-full px-6 text-[15px] font-medium transition-[filter] hover:brightness-110">
            Agregar al pedido
          </button>
          <button type="button" data-favorito={JSON.stringify(item)} aria-pressed="false" aria-label={`Guardar ${producto.nombre} en favoritos`} class="favorito grid size-12 place-items-center rounded-full border border-line text-accent hover:bg-tint">
            <Icono nombre="corazon" />
          </button>
        </div>

        <p class="mt-5 text-sm text-ink-soft">
          Pedidos con 24 a 48 hs de anticipación.
          <a href={consulta} target="_blank" rel="noopener" class="font-medium text-accent underline-offset-4 hover:underline">
            {producto.precio === null ? 'Consultá el precio por WhatsApp' : '¿Dudas? Escribinos por WhatsApp'}
          </a>
        </p>

        {relacionados.length > 0 && (
          <section class="mt-8" aria-labelledby="relacionados">
            <h2 id="relacionados" class="mb-2.5 font-sans text-[13px] font-semibold">También te puede gustar</h2>
            <div class="grid grid-cols-3 gap-2.5">
              {relacionados.map((r) => (
                <a href={`/producto/${r.slug}`} class="presionable block text-ink no-underline">
                  <Image
                    src={r.foto!}
                    alt=""
                    widths={[160, 320]}
                    sizes="(min-width: 768px) 160px, 30vw"
                    loading="lazy"
                    class="aspect-square w-full rounded-2xl bg-tint object-cover"
                  />
                  <span class="mt-1.5 block text-xs leading-snug md:text-sm">{r.nombre}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </div>

  <!-- Barra inferior de vidrio (mobile) -->
  <div class="liquid fixed inset-x-3 bottom-[max(18px,env(safe-area-inset-bottom))] z-40 flex items-center gap-2.5 rounded-full p-2 md:hidden">
    <div class="flex items-center rounded-full border border-line bg-field">
      <button type="button" data-paso="-1" data-objetivo="cantidad" aria-label="Quitar uno" class="grid size-11 place-items-center"><Icono nombre="menos" size={18} /></button>
      <span id="cantidad" data-valor="1" aria-live="polite" class="min-w-[18px] text-center text-[15px] font-semibold tabular-nums">1</span>
      <button type="button" data-paso="1" data-objetivo="cantidad" aria-label="Agregar uno" class="grid size-11 place-items-center"><Icono nombre="mas" size={18} /></button>
    </div>
    <button type="button" data-agregar={JSON.stringify(item)} data-cantidad-ref="cantidad" class="liquid-bordo h-12 flex-1 rounded-full text-[15px] font-medium active:scale-[.98] transition-transform">
      Agregar al pedido
    </button>
  </div>
</Layout>

<style is:global>
  .favorito[aria-pressed='true'] svg { fill: currentColor; }
</style>
