---
import Icono from './Icono.astro';
import { INSTAGRAM, whatsappLink } from '../lib/catalogo';
---

<footer class="mx-3 mb-28 mt-20 md:mx-6 md:mb-6">
  <div class="relative mx-auto flex max-w-6xl flex-col gap-8 overflow-hidden rounded-[32px] bg-cocoa-950 p-8 dark:bg-[#250B11] dark:ring-1 dark:ring-line text-cream-50 md:flex-row md:items-end md:justify-between md:p-10">
    <span aria-hidden="true" class="emblema pointer-events-none absolute -right-6 -top-12 h-[300px] select-none text-cream-50/[.07]"></span>

    <div class="relative">
      <p class="mb-2 text-xs uppercase tracking-[.14em] text-gold-400">Pedidos</p>
      <h2 class="font-serif text-[34px] font-normal leading-[1.05] md:text-4xl">Hacé tu pedido<br />por WhatsApp</h2>
      <p class="mt-3.5 max-w-sm text-sm leading-relaxed text-cream-50/75">
        Encargá con 24 a 48 hs de anticipación. Te confirmamos disponibilidad y entrega por mensaje.
      </p>
    </div>

    <div class="relative flex flex-wrap items-center gap-3">
      <a
        href={INSTAGRAM}
        target="_blank"
        rel="noopener"
        class="flex h-12 items-center gap-2 rounded-full border border-cream-50/25 px-5 text-[15px] font-medium text-cream-50 transition-colors hover:bg-cream-50/10"
      >
        <Icono nombre="instagram" size={18} />
        Instagram
      </a>
      <a
        href={whatsappLink('Hola Mica! Te escribo desde el catálogo.')}
        target="_blank"
        rel="noopener"
        class="flex h-12 items-center gap-2 rounded-full bg-cream-50 px-6 text-[15px] font-medium text-cocoa-950 transition-colors hover:bg-rose-200"
      >
        <Icono nombre="whatsapp" size={18} />
        Escribinos
      </a>
    </div>
  </div>
  <p class="mt-4 text-center text-xs text-ink-soft">© {new Date().getFullYear()} Moka · Micaela Denapole</p>
</footer>
