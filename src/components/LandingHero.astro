---
import { whatsappLink } from '../lib/catalogo';
---

<section class="relative h-dvh w-full overflow-hidden bg-cocoa-950">
  <div class="absolute inset-0">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="size-full object-cover"
    >
      <source src="/images/over.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(42_9_16/.75),rgb(42_9_16/.25)_55%,rgb(42_9_16/.45))]"></div>
  </div>

  <div class="relative z-10 flex h-full flex-col items-center justify-end px-5 pb-[max(48px,env(safe-area-inset-bottom))] text-center md:justify-center md:pb-0">
    <span aria-hidden="true" class="emblema emblema-chico mb-5 h-20 text-cream-50 md:h-24"></span>
    <h1 class="font-serif text-6xl font-normal tracking-[-.03em] text-cream-50 [font-variation-settings:'opsz'_144] md:text-8xl">Moka</h1>
    <p class="mb-10 mt-3 text-sm text-cream-50/85 md:text-base">Pastelería artesanal de Micaela Denapole</p>

    <div class="flex w-full max-w-xs flex-col gap-3">
      <a
        href="/catalogo"
        class="flex h-14 items-center justify-center rounded-full bg-cream-50 text-[15px] font-semibold text-cocoa-950 no-underline shadow-float transition-transform duration-300 active:scale-[.97] hover:scale-[1.02]"
      >
        Ver catálogo
      </a>
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener"
        class="liquid flex h-14 items-center justify-center rounded-full text-[15px] font-semibold text-cream-50 no-underline [background:linear-gradient(180deg,rgb(255_255_255/.22),rgb(255_255_255/.06))] transition-[filter] duration-300 hover:brightness-125"
      >
        Escribinos por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (!video) return;
    const reproducir = () => video.play().catch(() => {});
    reproducir();
    // Algunos celulares necesitan un toque antes de reproducir video
    document.addEventListener('touchstart', reproducir, { once: true });
  });
</script>
