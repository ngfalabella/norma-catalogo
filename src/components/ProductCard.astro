---
import FotoProducto from './FotoProducto.astro';
import Icono from './Icono.astro';
import type { ItemCliente, Producto } from '../lib/catalogo';

interface Props {
  producto: Producto;
  item: ItemCliente;
  eager?: boolean;
}
const { producto, item, eager = false } = Astro.props;
---

<article class="aparece relative" data-producto={producto.id}>
  <a href={`/producto/${producto.slug}`} class="presionable group block rounded-[var(--radius-card)] text-ink no-underline">
    <div class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] bg-tint shadow-warm">
      <FotoProducto
        producto={producto}
        eager={eager}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 270px, (min-width: 768px) 32vw, 50vw"
        class="transition-transform duration-700 ease-[var(--ease-soft)] group-hover:scale-[1.04]"
      />
      {producto.etiqueta && (
        <span class="glass-soft absolute left-2.5 top-2.5 rounded-full px-2.5 py-1.5 text-xs font-medium">{producto.etiqueta}</span>
      )}
    </div>
    <h3 class="mx-1 mt-2.5 font-serif text-base font-medium leading-tight md:text-lg" data-vt="titulo">
      {producto.nombre}
    </h3>
    <p
      class:list={['mx-1 mt-1 text-sm font-semibold tabular-nums md:text-[15px]', producto.precio === null ? 'text-ink-soft font-medium' : 'text-accent']}
      data-vt="precio"
    >
      {producto.precioTexto}
    </p>
  </a>

  <!-- Capa del tamaño de la foto: el botón "+" queda en su esquina sin anidarse dentro del enlace -->
  <div class="pointer-events-none absolute inset-x-0 top-0 aspect-[4/5]">
    <button
      type="button"
      data-agregar={JSON.stringify(item)}
      aria-label={`Sumar ${producto.nombre} al pedido`}
      class="glass-soft pointer-events-auto absolute bottom-2 right-2 grid size-11 place-items-center rounded-full text-accent transition-[scale,background-color] duration-200 hover:bg-cream-50 active:scale-90"
    >
      <Icono nombre="mas" size={16} />
    </button>
  </div>
</article>
