---
import LandingHero from '../components/LandingHero.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const titulo = 'Moka | Pastelería artesanal';
const descripcion = 'Pastelería artesanal de Micaela Denapole. Catálogo online de tortas, brownies, cheesecakes, minicakes y más. Pedidos por WhatsApp.';
const imagen = new URL('/images/social-image.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2A0910" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/logooo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{titulo}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <ClientRouter fallback="animate" />
  </head>

  <body class="overflow-hidden bg-cocoa-950 font-sans antialiased">
    <main>
      <LandingHero />
    </main>
  </body>
</html>
