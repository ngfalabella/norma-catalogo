---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import CategoryChips from '../components/CategoryChips.astro';
import { agruparPorCategoria, aItemCliente, destacadoDe, getProductos } from '../lib/catalogo';

export const prerender = false;

const productos = await getProductos();
const categorias = agruparPorCategoria(productos);
const items = await Promise.all(productos.map(aItemCliente));
const itemDe = new Map(items.map((i) => [i.id, i]));

const total = categorias.length;
const dosDigitos = (n: number) => String(n).padStart(2, '0');
let primeras = 0; // las primeras fotos se cargan sin lazy
---

<Layout
  title="Catálogo | Moka"
  items={items}
  categorias={categorias.map(({ nombre, id }) => ({ nombre, id }))}
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <!-- Tres niveles: título (marca del oficio), línea fina, y debajo qué es la página + cómo se pide -->
    <section class="hero-colapsa pb-1 pt-9 md:pb-2 md:pt-16">
      <h1 class="font-serif text-[46px] font-normal leading-[.95] tracking-[-.035em] [font-variation-settings:'opsz'_144] md:text-[76px] lg:text-[88px]">
        Pastelería<br class="md:hidden" /> artesanal
      </h1>
      <div class="mt-6 flex flex-col gap-1 border-t border-line pt-4 md:mt-8 md:flex-row md:items-baseline md:justify-between md:pt-5">
        <p class="font-serif text-[22px] font-light tracking-[-.01em] md:text-[28px]">Catálogo online</p>
        <p class="text-sm text-ink-soft md:text-[15px]">Los pedidos se confirman por WhatsApp.</p>
      </div>
    </section>

    <CategoryChips categorias={categorias} />

    <div class="space-y-14 pb-8 pt-6 md:space-y-20">
      {categorias.map((categoria, i) => {
        const destacado = destacadoDe(categoria);
        const resto = categoria.productos.filter((p) => p !== destacado);
        return (
          <section id={categoria.id} aria-labelledby={`t-${categoria.id}`} class="scroll-mt-36 md:scroll-mt-40">
            <div class="flex items-end justify-between px-1 pb-3.5 md:mb-5 md:border-b md:border-line md:pb-4">
              <div>
                <p class="mb-0.5 text-xs font-medium tracking-[.08em] text-ink-soft tabular-nums">
                  {dosDigitos(i + 1)} / {dosDigitos(total)}
                </p>
                <h2 id={`t-${categoria.id}`} class="font-serif text-[34px] font-normal tracking-[-.02em] md:text-[40px]">
                  {categoria.nombre}
                </h2>
              </div>
              <p class="mb-1.5 text-[13px] text-ink-soft md:text-sm">
                {categoria.productos.length} {categoria.productos.length === 1 ? 'producto' : 'productos'}
              </p>
            </div>

            <div class="grid grid-cols-2 gap-x-3 gap-y-5 md:grid-cols-3 md:gap-x-4 md:gap-y-6 lg:grid-cols-4">
              {destacado && (
                <FeaturedCard producto={destacado} item={itemDe.get(destacado.id)!} eager={i === 0} />
              )}
              {resto.map((p) => (
                <ProductCard producto={p} item={itemDe.get(p.id)!} eager={primeras++ < 4} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>
